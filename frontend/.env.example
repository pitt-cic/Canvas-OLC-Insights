# Copy to .env, fill in from your CDK stack outputs, then run `npm run build`.

# From the UserPoolId output
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
# From the UserPoolClientId output
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Shows the "Accept All AI Scores" button when set to true (off by default).
# Objectives with no AI score are never bulk-accepted.
# VITE_ENABLE_BULK_ACCEPT=true
